FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

ENV CHOKIDAR_USEPOLLING=1
ENV CHOKIDAR_POLLING_INTERVAL=300
ENV WATCHPACK_POLLING=true
ENV WATCHPACK_POLLING_INTERVAL=500

EXPOSE 3000

ENV APP_ENV=dev

CMD ["npm", "run", "dev"]
