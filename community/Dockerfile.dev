FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Next dev writes runtime artifacts under /app/.next, so the working tree must
# be writable before switching away from root.
RUN mkdir -p .next && chown -R 1000:1000 /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

ENV CHOKIDAR_USEPOLLING=1
ENV CHOKIDAR_POLLING_INTERVAL=300
ENV WATCHPACK_POLLING=true
ENV WATCHPACK_POLLING_INTERVAL=500

EXPOSE 3000

ENV APP_ENV=dev

USER 1000

CMD ["npm", "run", "dev"]
